APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
# chrome_devtools (default) | browser_use | stagehand | openclaw | mock
AGENT_ADAPTER=chrome_devtools
STAGEHAND_MODE=python
CHROME_DEVTOOLS_URL=http://127.0.0.1:9222
# OpenClaw (optional agent backend; use AGENT_ADAPTER=openclaw)
OPENCLAW_CMD=openclaw
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TIMEOUT_SEC=600
# Start Chrome with remote debugging before publish, e.g.:
# chrome.exe --remote-debugging-port=9222 --user-data-dir="%TEMP%\oa-chrome"
