APP_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
# stagehand (default) | browser_use | chrome_devtools | openclaw | mock
AGENT_ADAPTER=stagehand
STAGEHAND_MODE=python
CHROME_DEVTOOLS_URL=http://127.0.0.1:9222
# One-click start (recommended):
#   python -m app.launcher
#   Windows: powershell -File scripts/start.ps1
# OpenClaw (optional agent backend; use AGENT_ADAPTER=openclaw)
OPENCLAW_CMD=openclaw
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TIMEOUT_SEC=600
# Start Chrome with remote debugging before publish:
#   Windows: powershell -File scripts/start_chrome_cdp.ps1
# Start server WITHOUT --reload on Windows:
#   powershell -File scripts/start_server.ps1
